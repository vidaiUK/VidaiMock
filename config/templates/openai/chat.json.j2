{% import "usage/macros.j2" as u -%}
{#
   OpenAI chat completion response template.

   Switches response shape based on request fields (order matters):
     - tools present + tool_result already in history -> plain text synthesis
       (terminates agentic tool-calling loops; otherwise ADK/LangGraph
       would call the mock forever)
     - tools present                                 -> tool_calls response
     - response_format                               -> structured output
     - o-series model                                -> reasoning usage tokens
     - default                                       -> plain assistant text
#}
{% if json.tools is defined and json.tools | length > 0 and has_tool_result(messages=json.messages | default(value=[]), provider="openai") %}
{
  "id": "chatcmpl-{{ uuid() }}",
  "object": "chat.completion",
  "created": {{ timestamp() }},
  "model": "{{ model }}",
  "choices": [
    {
      "index": 0,
      "message": {
        "role": "assistant",
        "content": "Based on the tool results, here is the answer.",
        "refusal": null,
        "annotations": []
      },
      "logprobs": null,
      "finish_reason": "stop"
    }
  ],
  "usage": {{ u::openai(o=usage_override, input=72, output=14, reasoning=0) }},
  "service_tier": "default",
  "system_fingerprint": "fp_mock_vidai"
}
{% elif json.tools is defined and json.tools | length > 0 %}
{
  "id": "chatcmpl-{{ uuid() }}",
  "object": "chat.completion",
  "created": {{ timestamp() }},
  "model": "{{ model }}",
  "choices": [
    {
      "index": 0,
      "message": {
        "role": "assistant",
        "content": null,
        "tool_calls": [
          {
            "id": "call_mock_{{ random_int(min=1000, max=9999) }}",
            "type": "function",
            "function": {
              "name": "{{ json.tools.0.function.name | default(value='mock_tool') }}",
              "arguments": "{}"
            }
          }
        ],
        "refusal": null,
        "annotations": []
      },
      "logprobs": null,
      "finish_reason": "tool_calls"
    }
  ],
  "usage": {{ u::openai(o=usage_override, input=51, output=14, reasoning=0) }},
  "service_tier": "default",
  "system_fingerprint": "fp_mock_vidai"
}
{% elif json.response_format is defined %}
{
  "id": "chatcmpl-{{ uuid() }}",
  "object": "chat.completion",
  "created": {{ timestamp() }},
  "model": "{{ model }}",
  "choices": [
    {
      "index": 0,
      "message": {
        "role": "assistant",
        "content": "{\"x\":1}",
        "refusal": null,
        "annotations": []
      },
      "logprobs": null,
      "finish_reason": "stop"
    }
  ],
  "usage": {{ u::openai(o=usage_override, input=41, output=5, reasoning=0) }},
  "service_tier": "default",
  "system_fingerprint": "fp_mock_vidai"
}
{% elif json.model is defined and json.model is starting_with("o") %}
{
  "id": "chatcmpl-{{ uuid() }}",
  "object": "chat.completion",
  "created": {{ timestamp() }},
  "model": "{{ model }}",
  "choices": [
    {
      "index": 0,
      "message": {
        "role": "assistant",
        "content": "four",
        "refusal": null,
        "annotations": []
      },
      "finish_reason": "stop"
    }
  ],
  "usage": {{ u::openai(o=usage_override, input=18, output=83, reasoning=64) }},
  "service_tier": "default",
  "system_fingerprint": null
}
{% else %}
{
  "id": "chatcmpl-{{ uuid() }}",
  "object": "chat.completion",
  "created": {{ timestamp() }},
  "model": "{{ model }}",
  "choices": [
    {
      "index": 0,
      "message": {
        "role": "assistant",
        "content": "{% if generated_text %}{{ generated_text }}{% else %}This is a mock response from VidaiMock. Model: {{ model }}{% endif %}",
        "refusal": null,
        "annotations": []
      },
      "logprobs": null,
      "finish_reason": "stop"
    }
  ],
  "usage": {{ u::openai(o=usage_override, input=10, output=10, reasoning=0) }},
  "service_tier": "default",
  "system_fingerprint": "fp_mock_vidai"
}
{% endif %}
