{#
   Groq chat.completion response.

   Groq is OpenAI-compatible on the wire but keeps its own usage block
   (queue_time / prompt_time / completion_time / total_time) and system
   fingerprint, so this template stays separate from openai/chat.json.j2
   rather than reusing it.

   Branches (order matters):
     - tools present + tool result already in history -> plain text synthesis
       (terminates agentic loops; otherwise a client calls the mock forever)
     - tools present                                 -> tool_calls response
     - default                                       -> echo the prompt

   Tool branches mirror openai/chat.json.j2 so tool calling behaves the same
   across every OpenAI-compatible provider (VM-013).
#}
{% set has_tools = json.tools is defined and json.tools | length > 0 %}
{% if has_tools and has_tool_result(messages=json.messages, provider="openai") %}
{
    "id": "chatcmpl-{{ uuid() }}",
    "object": "chat.completion",
    "created": {{ timestamp() }},
    "model": "{{ model }}",
    "choices": [
        {
            "index": 0,
            "message": {
                "role": "assistant",
                "content": "Based on the tool results, here is the answer."
            },
            "logprobs": null,
            "finish_reason": "stop"
        }
    ],
    "usage": {
        "queue_time": 0.012,
        "prompt_tokens": 72,
        "prompt_time": 0.001,
        "completion_tokens": 14,
        "completion_time": 0.045,
        "total_tokens": 86,
        "total_time": 0.058
    },
    "system_fingerprint": "fp_mock_groq"
}
{% elif has_tools %}
{
    "id": "chatcmpl-{{ uuid() }}",
    "object": "chat.completion",
    "created": {{ timestamp() }},
    "model": "{{ model }}",
    "choices": [
        {
            "index": 0,
            "message": {
                "role": "assistant",
                "content": null,
                "tool_calls": [
                    {
                        "id": "call_mock_{{ random_int(min=1000, max=9999) }}",
                        "type": "function",
                        "function": {
                            "name": "{{ json.tools.0.function.name | default(value='mock_tool') }}",
                            "arguments": "{}"
                        }
                    }
                ]
            },
            "logprobs": null,
            "finish_reason": "tool_calls"
        }
    ],
    "usage": {
        "queue_time": 0.012,
        "prompt_tokens": 51,
        "prompt_time": 0.001,
        "completion_tokens": 14,
        "completion_time": 0.045,
        "total_tokens": 65,
        "total_time": 0.058
    },
    "system_fingerprint": "fp_mock_groq"
}
{% else %}
{
    "id": "chatcmpl-{{ uuid() }}",
    "object": "chat.completion",
    "created": {{ timestamp() }},
    "model": "{{ model }}",
    "choices": [
        {
            "index": 0,
            "message": {
                "role": "assistant",
                "content": "Hello from Groq Mock! You said: {{ prompt }}"
            },
            "logprobs": null,
            "finish_reason": "stop"
        }
    ],
    "usage": {
        "queue_time": 0.012,
        "prompt_tokens": 10,
        "prompt_time": 0.001,
        "completion_tokens": 5,
        "completion_time": 0.045,
        "total_tokens": 15,
        "total_time": 0.058
    },
    "system_fingerprint": "fp_mock_groq"
}
{% endif %}
